---
import "@styles/main.css";
import { Font } from "astro:assets";
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <header>
    <h5>Ask<span>Experts</span></h5>
    <nav>
      <button popovertarget="responsivemenu">Menu</button>
      <ul popover id="responsivemenu">
        <li>
          <a href="/" aria-current={currentPath === "/" ? "page" : undefined}
            >Home</a
          >
        </li>
        <li>
          <a
            href="/case-studies/"
            aria-current={currentPath.startsWith("/case-studies")
              ? "page"
              : undefined}>Case studies</a
          >
        </li>
        <li>
          <a
            href="/team/"
            aria-current={currentPath.startsWith("/team") ? "page" : undefined}
            >Team</a
          >
        </li>
        <li>
          <a
            href="/about/"
            aria-current={currentPath.startsWith("/about") ? "page" : undefined}
            >About</a
          >
        </li>
      </ul>
    </nav>

    <button popovertarget="login">Login</button>

    <ul popover id="login">
      <h2>Dashboard Login</h2>
      <label for="email">Email adress</label>
      <input type="text" id="email" name="email" /><br />
      <label for="password">Password</label>
      <input type="text" id="password" name="password" /><br />
      <button>Go to dashboard</button>
    </ul>
  </header>

  <body>
    <main>
      <slot />
    </main>
    <section>
      <h4>STAY UPDATED</h4>
      <h2>Subscribe Our Newsletter</h2>
      <p>
        Build stronger Customer Relationships with <span>Consultalk </span>
      </p>
      <input type="text" placeholder="your mail adress" />
      <button>Subscribe</button>
    </section>

    <footer>
      <h5>Ask<span>Experts</span></h5>
      <p>©2026 Consultalk. All rights reserved</p>
      <p>Terms of Service | Privacy Policy</p>
    </footer>
  </body>

  <style>
    header {
      background: var(--color-neutrals-900);
      container-type: inline-size;
      display: flex;
      justify-content: space-evenly;
      align-items: center;
      padding-inline: clamp(1rem, 5vw, 4rem);

      nav {
        display: inherit;
        align-items: center;
        gap: 2rem;

        ul {
          list-style-type: "";
          background: var(--color-neutrals-900);

          @container (width <= 600px) {
            &:popover-open {
              position-area: bottom span-left;
              display: grid;
              background: var(--color-neutrals-900);
            }
          }

          @container (width > 600px) {
            display: flex;
            gap: 2rem;
            position: static;
          }
        }

        button {
          display: none;

          @container (width <= 600px) {
            display: block;
          }
        }
      }
    }

    a {
      color: var(--color-neutrals-50);
      font-family: var(--font-lato);
      text-decoration-line: none;
      font-size: var(--paragraph-);
    }

    nav {
      a {
        &[aria-current="page"]::after {
          content: "";
          display: block;
          border-bottom: 3px solid var(--color-yellow-500);
        }
      }
    }

    button {
      border-radius: 50px;
      place-self: center;
      padding-inline: 1rem;
      font-family: var(--font-lato);
    }

    section {
      button {
        background: var(--color-yellow-500);
        border: 1px solid var(--color-yellow-500);
        margin-left: 1rem;
        padding-block: 0.5rem;
      }
    }

    header {
      button {
        background: var(--color-neutrals-50);
        border: 1px solid var(--color-neutrals-50);
      }
    }

    header,
    footer {
      h5 {
        font-size: clamp(1.0417rem, 0.8452rem + 0.873vw, 1.5rem);
        color: var(--color-neutrals-50);

        span {
          color: var(--color-yellow-500);
        }
      }

      [popover] {
        &::backdrop {
          background: #0003;
        }
      }
      @supports (position-area: bottom span-left) {
        #login[popover] {
          inset: auto;
          margin: 0;
          margin-top: 1rem;
          position-area: bottom span-left;
        }
      }
      #login:popover-open {
        padding-block: 0.5rem;
        padding: 2rem;
        display: flex;
        flex-wrap: wrap;
        flex-direction: column;

        border-radius: 15px;
        border: none;
        background: var(--color-surface-primary);
        button {
          background: var(--color-yellow-500);
          padding-block: 0.5rem;
          width: 15em;
          color: var(--color-text);
          font-family: var(--font-cabin);
        }
        h2 {
          text-align: center;
          margin-top: -1rem;
          margin-bottom: 1rlh;
          font-size: var(--heading-4);
        }
        input {
          border: 1px solid var(--color-neutrals-400);
        }
        input,
        label {
          border-radius: 50px;
          padding-block: 0.5rem;
          width: 15rem;
        }
      }
    }

    section {
      background: var(--color-neutrals-900);
      text-align: center;
      padding-block: 3rem;

      input {
        border-radius: 50px;
        padding-block: 0.5rem;
        width: 15%;

        border: 1px solid var(--color-neutrals-50);

        &::placeholder {
          color: var(--color-neutrals-700);
        }
      }

      h4 {
        color: var(--color-yellow-500);
        font-family: var(--font-lato);
        font-size: 16px;
      }

      h2 {
        color: var(--color-neutrals-50);
        font-size: 35px;
      }

      span {
        color: var(--color-yellow-500);
      }
    }

    p {
      color: var(--color-neutrals-400);
      font-family: var(--font-lato);
    }

    footer {
      background: var(--color-neutrals-900);
      display: flex;
      justify-content: space-evenly;
      align-items: center;
      padding-block: 1rem;
      border-top: 1px solid var(--color-neutrals-700);
    }
  </style>
</html>
