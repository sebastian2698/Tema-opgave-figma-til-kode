---
import "@styles/main.css";
import { Font } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <header>
    <h1>Ask<span>Experts</span></h1>
    <nav>
      <button popovertarget="responsivemenu">Menu</button>
      <ul popover id="responsivemenu">
        <li><a href="/">Home</a></li>
        <li><a href="/case-studies/">Case studies</a></li>
        <li><a href="/team/">Team</a></li>
        <li><a href="/about/">About</a></li>
      </ul>
    </nav>

    <button popovertarget="login">Login</button>
    <ul popover id="login">
      <h1>Dashboard login</h1>
      <label for="email">Email adress</label>
      <input type="text" id="email" name="email" /><br />
      <label for="password">Password</label>
      <input type="text" id="password" name="password" /><br />
      <button>Go to dashboard</button>
    </ul>
  </header>
  <body>
    <main>
      <slot />
    </main>
    <section>
      <h4>STAY UPDATED</h4>
      <h2>Subscribe Our Newsletter</h2>
      <p>
        Build stronger Customer Relationships with <span>Consultalk </span>
      </p>
      <input type="text" placeholder="your mail adress" />
      <button>Subscribe</button>
    </section>

    <footer>
      <h1>Ask<span>Experts</span></h1>
      <p>©2026 Consultalk. All rights reserved</p>
      <p>Terms of Service | Privacy Policy</p>
    </footer>
  </body>

  <style>
    header {
      background: var(--color-neutrals-900);
      container-type: inline-size;
      display: flex;
      justify-content: space-evenly;
      align-items: center;
      padding-inline: clamp(1rem, 5vw, 4rem);
      padding-block: 1rem;

      nav {
        display: inherit;
        align-items: center;
        gap: 2rem;

        ul {
          list-style-type: "";
          background: var(--color-neutrals-900);

          &:popover-open {
            position-area: bottom span-left;
            display: grid;
            background: var(--color-neutrals-900);
          }

          @container (width > 600px) {
            margin: 0;
            position: static;
            display: flex;
            border: none;
          }
        }

        button {
          display: none;

          @container (width <= 600px) {
            display: block;
          }
        }
      }
    }
    a {
      color: var(--color-neutrals-50);
      font-family: var(--font-lato);
      text-decoration-line: none;
      font-size: 18px;
    }

    button {
      border-radius: 50px;
      place-self: center;
      padding-inline: 1rem;
      font-family: var(--font-lato);
    }

    section {
      button {
        background: var(--color-yellow-500);
        border: 1px solid var(--color-yellow-500);
        margin-left: 1rem;
        padding-block: 0.5rem;
      }
    }
    header {
      button {
        background: var(--color-neutrals-50);
        border: 1px solid var(--color-neutrals-50);
      }
    }
    header,
    footer {
      h1 {
        font-size: var(--heading-1);
        color: var(--color-neutrals-50);
        span {
          color: var(--color-yellow-500);
        }
      }
    }

    section {
      background: var(--color-neutrals-900);
      text-align: center;
      padding-block: 3rem;

      > * + * {
        margin-top: 1rlh;
      }
      input {
        border-radius: 50px;
        padding-block: 0.5rem;
        width: 15%;

        border: 1px solid var(--color-neutrals-50);
        &::placeholder {
          color: var(--color-neutrals-700);
        }
      }

      h4 {
        color: var(--color-yellow-500);
        font-family: var(--font-lato);
        font-size: 16px;
      }
      h2 {
        color: var(--color-neutrals-50);
        font-size: 35px;
      }
      span {
        color: var(--color-yellow-500);
      }
    }

    p {
      color: var(--color-neutrals-400);
      font-family: var(--font-lato);
    }

    footer {
      background: var(--color-neutrals-900);
      display: flex;
      justify-content: space-evenly;
      align-items: center;
      padding-block: 1rem;
      border-top: 1px solid var(--color-neutrals-700);
    }
  </style>
</html>
