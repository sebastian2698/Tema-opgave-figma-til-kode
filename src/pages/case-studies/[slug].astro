---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Introtexts from "@components/Introtexts.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <Introtexts
    page="CASE STUDIES"
    title="Taxes & Efficiency"
    text="Our achievements reflect the close collaboration between our expert teams
      and our esteemed clientele. We cultivate a workplace that champions peak
      performance and guarantees client satisfaction."
  />

  <article class="case-story-article">
    <header>
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />
      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>
        <a href="#0" class="button">{buttonLabel}</a>
      </div>
    </header>
    <section class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <>
            {index === 0 ? <h2>{section.title}</h2> : <h3>{section.title}</h3>}

            {Array.isArray(section.content) ? (
              <>
                {section.content.map((item) => (
                  <p>{item}</p>
                ))}
              </>
            ) : (
              <p>{section.content}</p>
            )}
            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                  style="anchor-name: --title;"
                />
                {section.image.caption && (
                  <figcaption style="position-anchor: --title">
                    {" "}
                    {section.image.caption}
                  </figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </section>
  </article>
</Layout>

<style>
  header {
    margin: 10em;
  }
  .case-story-article {
    container: article / inline-size;
  }
  .case-story-content {
    display: grid;
    grid-template-columns: 1fr minmax(0, 68ch) 1fr;
    margin-inline: auto;
    --flow-space: 0.5rlh;
    > * {
      grid-column: 2;
    }
    > * + * {
      margin-top: var(--flow-space, 0.75rlh);
    }

    li {
      padding: var(--flow-space) calc(0.5rlh - 1rlh);
      color: var(--color-text-muted);
    }
    p {
      padding-block: var(--flow-space, 1rlh);
      color: var(--color-text-muted);
      text-box: cap alphabetic;
    }
    figure {
      grid-column: 1/-1;
      width: min(90ch, calc(100vw - 2rem));
      justify-self: center;
      position: relative;
    }

    figure::after {
      content: "";
      position: absolute;
      inset: 0;
      box-shadow: inset 0 -30px 30px rgba(0, 0, 0, 0.8);
    }

    img {
      display: block;
      width: 100%;
      height: 400px;
      object-fit: cover;
    }
    figcaption {
      position: absolute;
      position-anchor: --title;
      align-self: end;
      margin: 1rem;
      position-area: center;
      justify-self: center;
      font-size: var(--paragraph-);
      color: var(--color-neutrals-200);
      padding-inline: 1rem;
      z-index: 1;
    }
  }

  .case-details {
    display: flex;
    align-items: flex-start;
    background: var(--color-ui-primary);
    color: var(--color-neutrals-100);
    max-inline-size: min(100ch, calc(100% - 3rem));
    margin: -2rem auto 5rlh;
    padding: 2rlh;
    border-radius: 1rem;
    position: relative;
    z-index: 1;

    dl {
      display: flex;
      justify-content: space-between;
      gap: 3rlh;
    }
  }
  .case-details {
    .button {
      margin-inline-start: auto;
      background: var(--color-yellow-500);
      padding-inline: 2rem;
      padding-block: 0.5rem;
      border-radius: 50px;
      color: var(--color-text);
      font-family: var(--font-cabin);
    }
  }

  h2 {
    font-size: var(--heading-2);
  }
  h3 {
    font-size: var(--heading-3);
  }

  img:not(figure img) {
    display: block;
    width: max(60ch, calc(100% - 1rem));
    height: auto;
    border-radius: 1rem;
    object-fit: cover;
    aspect-ratio: 5/2;
  }
  header {
    margin: 2em;
  }
  @container (width <= 600px) {
    img:not(figure img) {
      display: flex;
      gap: 1rem;
      align-items: start;
    }

    header {
      margin: 3em;
    }

    .case-details {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      max-inline-size: calc(100% - 1rem);
      margin: -2rem auto 0.2rlh;
      padding: 0.2rlh;
    }
  }
  dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rlh;
  }
  .button {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
</style>
