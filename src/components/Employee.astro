---
const response = await fetch("https://ftk-api.pages.dev/team");
const team = await response.json();
import Facebook from "@icons/facebook.svg";
import Instagram from "@icons/instagram.svg";

console.log(team);
---

<section>
  {
    team.map((employee: any) => (
      <article>
        <a href={`/team/${employee.slug}`}>
          <img
            src={employee.image.src}
            alt={employee.image.alt}
            style={`anchor-name: --${employee.slug}; view-transition-name: img-${employee.slug}`}
          />
        </a>
        <p class="anchor" style={`position-anchor: --${employee.slug}`}>
          {employee.title}
        </p>

        <h3>{employee.name}</h3>

        <p>{employee.description}</p>
        <div class="facebookinstagram">
          <Instagram />
          <Facebook />
        </div>
      </article>
    ))
  }
</section>
<style>
  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    margin-inline: auto;
    max-width: 1200px;

    img {
      object-fit: cover;
      width: 350px;
      height: 400px;
      border-radius: 1rem;
      margin-inline: auto;
    }

    h3 {
      font-size: var(--heading-3);
      text-align: center;
      font-family: var(--font-cabin);
      color: var(--color-ui-primary);
      margin-top: 1rlh;
      margin: 1rem;
    }

    p {
      text-align: center;
      padding-inline: var(--space-s);
      margin-bottom: 1rlh;
      color: var(--color-text-muted);
    }

    p.anchor {
      position: absolute;
      position-anchor: --title;
      inset: auto;
      margin: 0.5rem;
      position-area: center;
      justify-self: end;
      align-self: end;
      border-radius: 50px;
      background: var(--color-neutrals-900);
      color: var(--color-neutrals-200);
      padding-inline: 1rem;
      font-family: var(--font-lato);
    }

    svg {
      width: 1lh;
      height: 1lh;
    }

    .facebookinstagram {
      display: flex;
      gap: 1rem;
      justify-self: center;
      margin-bottom: 5rlh;
    }
  }
</style>
