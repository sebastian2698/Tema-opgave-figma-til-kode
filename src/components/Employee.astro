---
const response = await fetch("https://ftk-api.pages.dev/team");
const team = await response.json();

console.log(team);
---

<section>
  {
    team.map((employee: any) => (
      <article>
        <a href={`/team/${employee.slug}`}>
          <img src={employee.image.src} alt={employee.image.alt} />
        </a>
        <p>{employee.title}</p>
        <h5>{employee.name}</h5>

        <p>{employee.description}</p>
      </article>
    ))
  }
</section>
<style>
  section {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(400px, 100%), 1fr));
    gap: 1rem;

    article {
      display: grid;
      grid-template-columns: subgrid;
    }
    a {
      display: grid;
    }
    img {
      object-fit: cover;
      max-width: 400px;
      margin-inline: auto;
      border-radius: 1rem;
      grid-area: 1/1;
    }

    h5 {
      font-size: var(--heading-5);
      text-align: center;
      font-family: var(--font-cabin);
      color: var(--color-ui-primary);
    }

    p {
      text-align: center;
      padding-inline: clamp(1rem, 5vw, 4rem);
    }

    p:nth-of-type(1) {
      color: var(--color-surface-primary);
      border: 1px solid var(--color-ui-primary);
      border-radius: 50px;
      place-self: center start;
      grid-area: 1/1;
      background: var(--color-ui-primary);
    }
  }
</style>
