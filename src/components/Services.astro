---
//@ts-nocheck
import ServiceCard from "@components/ServiceCard.astro";

const serviceData = await fetch("https://ftk-api.pages.dev/services").then(
  (res) => res.json(),
);
---

<div class="services">
  {serviceData.map((service) => <ServiceCard service={service} />)}
</div>

<style>
  @layer components {
    .services {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr;
      padding: 2rem 2rem 2rem 2rem;
      gap: 2rem;
      width: 350px;
      height: 260px;
    }
    .ServiceCard {
      justify-content: center;
    }
  }
</style>
