---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import MadsImage from "../data/images/mads.webp";
import Checkmark from "@icons/checkmark.svg";
---

<section class="section-grid hero">
  <article class="hero-layout">
    <div class="hero-content pattern">
      <h1>Empowering Your Business Growth</h1>

      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>

      <div class="actions">
        <a href="#0">Book a Meeting</a>
        <a class="ghost" href="#0">Learn More →</a>
      </div>
    </div>

    <figure>
      <Image src={CEOImage} alt="CEO" />
    </figure>

    <div class="hero-services">
      <Services />
    </div>
  </article>
</section>

<section class="section-grid expect">
  <article>
    <figure>
      <Image src={MadsImage} alt="Kollegaer, der arbejder sammen" />
    </figure>

    <div class="section-text">
      <h4>WE'LL WORK WITH YOU</h4>
      <h2>What To Expect</h2>
      <p>
        Our collaboration is built on transparency, efficiency, and measurable
        results. Together, we create strategies tailored to your unique needs
        and goals.
      </p>

      <ul>
        <li>
          <Checkmark aria-hidden="true" />
          <span>
            Collaborate to build actionable strategies that drive sustainable
            growth and deliver tangible outcomes.
          </span>
        </li>

        <li>
          <Checkmark aria-hidden="true" />
          <span>
            Identify opportunities to optimize processes and implement impactful
            solutions with measurable results.
          </span>
        </li>
      </ul>
    </div>
  </article>
</section>

<style>
  /* Styles her */

  /******************** Ovweordnet sektion *******************/
  .section-grid {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, var(--content-width, 75rem))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];

    padding-block: var(--section-space, 5rem);
  }

  .section-grid > article {
    grid-column: content;
    min-width: 0;
    margin: 0;
  }

  /************************  hero (tekst og gitter) sektion ************************/
  .hero {
    padding-block: 0;
    margin-bottom: 20px;
    background-color: var(--color-neutrals-900);
    color: var(--color-neutrals-50);
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, calc(var(--content-width, 75rem) / 2))
      [middle] minmax(0, calc(var(--content-width, 75rem) / 2))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];
  }

  .hero > article {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
  }
  /********** grids *******/
  .hero > article > .hero-content {
    grid-column: content-start / middle;
    grid-row: 1;
    align-self: stretch;
    align-content: center;
    min-width: 0;
    padding: 4rem 2rem 7rem 0;
  }

  .hero > article > figure {
    overflow: hidden;
  }

  .hero > article > figure > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;

    object-position: 50% 50%;
    transform: scale(1.25);
    transform-origin: 50% 40%;
  }

  @media (max-width: 48rem) {
    .hero > article > figure > :global(img) {
      height: auto;
      transform: none;
    }
  }

  h1 {
    max-width: 14ch;
    margin: 0 0 1rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 1.1;
    color: var(--color-surface-primary);
  }

  h2 {
    max-width: 14ch;
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.1;
    color: var(--color-neutrals-900);
  }
  p {
    max-width: 45ch;
    margin: 0 0 1.5rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  h4 {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    justify-self: left;
  }

  .pattern {
    --pattern-color: var(--color-yellow-500);
    background:
      radial-gradient(ellipse farthest-side at 65% 35%, #0000, #000),
      conic-gradient(
          from 180deg at 1px 1px,
          alpha(from var(--pattern-color) / 0.35) 75%,
          #0000 0
        ) -1px -1px /
        80px 80px,
      #000;
    justify-items: left;
  }

  /************* knapper **********/
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .actions > a {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.5rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--color-action, #ffcc41);
    color: #080d18;
    text-decoration: none;
  }

  .actions > .ghost {
    border-color: #697080;
    background: transparent;
    color: white;
  }

  .hero > article > figure {
    grid-column: middle / full-end;
    grid-row: 1;
    min-width: 0;
    margin: 0;
  }

  .hero > article > figure > :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
  }

  .expect > article > figure > :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 1.6;
    height: auto;
    object-fit: cover;
    border-radius: 1rem;
  }

  .hero > article > .hero-services {
    grid-column: content-start / content-end;
    grid-row: 1;
    align-self: end;
    min-width: 0;
    z-index: 1;
    transform: translateY(50%);
  }
  /************************  under hero sektion / "What To Expect" ************************/

  .expect {
    padding-top: 10rem;
    background: white;
    color: #080d18;
  }

  .expect > article {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: var(--content-gap, 3rem);
  }

  .expect > article > figure {
    position: relative;
    isolation: isolate;
    min-width: 0;
    margin: 0;
  }

  .expect > article > figure::before {
    content: "";
    position: absolute;
    top: -1.5rem;
    left: -1rem;
    width: 30%;
    height: 40%;
    border-radius: 1rem;
    background: var(--color-green-400, #a3eba3);
    z-index: -1;
  }

  .expect > article > figure > :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1rem;
  }

  .section-text > ul {
    display: grid;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .section-text > ul > li {
    display: grid;

    grid-template-columns: 1.1rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;

    color: var(--color-text-muted);
    line-height: 1.5;
  }

  .section-text > ul > li > :global(svg) {
    display: block;
    width: 1.1rem;
    height: 1.1rem;

    margin-top: 0.2rem;
    color: #27b737;
  }

  .section-text {
    display: grid;
    gap: 1rem;
    min-width: 0;
    > * {
      margin: 0;
    }
  }

  .section-text > p,
  .section-text li {
    line-height: 1.6;
  }

  .section-text > ul {
    display: grid;
    gap: 1rem;
    padding-inline-start: 1.25rem;
  }

  @media (max-width: 48rem) {
    .hero > article > .hero-content {
      grid-column: content-start / content-end;
      padding: 3rem 0;
    }

    .hero > article > figure {
      grid-column: content-start / content-end;
      grid-row: 2;
    }

    .hero > article > figure > :global(img) {
      min-height: 0;
      height: auto;
    }

    .hero > article > .hero-services {
      grid-row: 3;
      padding-block: 2rem;
      transform: none;
    }

    .expect {
      padding-top: 4rem;
    }

    .expect > article {
      grid-template-columns: 1fr;
    }
  }
</style>
