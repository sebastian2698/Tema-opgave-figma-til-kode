---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import MadsImage from "../data/images/mads.webp";
---

<section>
  <article class="pattern">
    <div class="hero-content">
      <h1>Empowering Your <br />Business Growth</h1>
      <p>
        Discover tailored strategies and expert insights to take your business
        to the next level. Let us help you navigate challenges and achieve
        sustainable success.
      </p>
      <button><a href="#0">Book a Meeting</a> </button>
      <button class="ghost"><a href="#0">Learn More</a></button>
    </div>
  </article>
  <Image src={CEOImage} alt="CEO" />
</section>

<Services />

<section class="work_with_you">
  <figure>
    <Image src={MadsImage} alt="CEO" />
  </figure>

  <h4>WE'LL WORK WITH YOU</h4>
  <h2>What To Expect</h2>
  <p>
    Our collaboration is built on transparency, efficiency, and measurable
    results. Together, we create strategies tailored to your unique needs and
    goals.
  </p>

  <ul>
    <li>
      Collaborate to build actionable strategies that drive sustainable growth
      and deliver tangible outcomes.
    </li>

    <li>
      Identify opportunities to optimize processes and implement impactful
      solutions with measurable results.
    </li>
  </ul>
</section>

<style>
  section {
    display: grid;
    grid-template-columns: auto auto;
    background-color: var(--color-ui-primary);

    article {
      height: 100%;
    }

    .pattern {
      --pattern-color: var(--color-yellow-500);
      background:
        radial-gradient(ellipse farthest-side at 65% 35%, #0000, #000),
        conic-gradient(
            from 180deg at 1px 1px,
            alpha(from var(--pattern-color) / 0.35) 75%,
            #0000 0
          ) -1px -1px /
          80px 80px,
        #000;
      justify-items: left;
    }
  }

  /* Styles her */
  @layer components {
    .hero {
      background-color: #f3f4f6;
      padding: 2rem;
    }
  }
  button {
    background-color: var(--color-action);
    color: var(--color-ui-primary);

    .ghost {
      background-color: var(--color-ui-primary);
      color: var(--color-on-ui-primary);
    }
  }

  img {
    max-width: 800px;
    height: 600px;
    align-self: start;
    object-fit: cover;
    justify-self: right;
  }

  figure {
    margin-inline: auto;
    max-inline-size: 300px;
    margin: 3rem 1rem;
    display: block;
  }

  figure {
    position: relative;
    isolation: isolate;
    border-radius: 10px;

    &::before {
      content: "";
      position: absolute;
      top: -1rem;
      right: -1rem;
      width: 100px;
      height: 100px;
      background: var(--color-green-400);
      z-index: -1;
      border-radius: 10px;
    }
  }

  h1 {
    color: var(--color-surface-primary);
    font-size: 3rem;
  }

  ul {
    display: grid;
    gap: 1rem;
    max-width: 45ch;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }

  li:before {
    content: "";
    width: 1.6rem;
    height: 1lh;
    background: "{checkmark}" 50% 50% / 100% auto no-repeat;
  }
</style>
