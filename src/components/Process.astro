---
import { Image } from "astro:assets";

import andreaImage from "../data/images/pexels-andrea.webp";
import annaImage from "../data/images/pexels-anna.webp";
import shvetsImage from "../data/images/pexels-shvets.webp";
import CoreValuesHero from "@components/Core-values-Hero.astro";

import Clock from "@icons/clock.svg";
import Phone from "@icons/phone.svg";
import Pin from "@icons/pin.svg";
---

<CoreValuesHero />
<section>
  <article class="section-text">
    <h4>Process</h4>
    <h2>Contact Us. It’s Easy.</h2>
    <p>
      Leverage agile frameworks to provide a robust synopsis for high level
      overviews. Iterative approaches to corporate strategy foster
      collaborative.
    </p>

    <div class="info">
      <ul>
        <li>
          <span><Phone aria-hidden="true" /></span>
          <div>
            <p>Call Today</p>
            <a href="tel:+1800100900">+1 800 100 900</a>
          </div>
        </li>

        <li>
          <span><Clock aria-hidden="true" /></span>
          <div>
            <p>Monday To Friday</p>
            <strong>9AM - 5PM</strong>
          </div>
        </li>

        <li>
          <span><Pin aria-hidden="true" /></span>
          <div>
            <p>USA Office</p>
            <a href="https://maps.app.goo.gl/kzTYgNNieHenF2BY9">
              195 Devonshire St Boston, MA 02110
            </a>
          </div>
        </li>
      </ul>
    </div>
  </article>

  <div class="Process-pic">
    <figure>
      <Image src={annaImage} alt="Medarbejder i en stol" />
    </figure>

    <figure>
      <Image src={andreaImage} alt="Kollegaer taler sammen" />
    </figure>

    <figure>
      <Image src={shvetsImage} alt="Kollegaer samarbejder" />
    </figure>
  </div>
</section>

<style>
  section {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, calc(var(--content-width, 75rem)))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];
    row-gap: 2.5rem;
    padding-block: clamp(4rem, 8vw, 8rem);
    background: var(--color-on-ui-primary, white);
    color: #080d18;
  }
  section > .section-text {
    width: 40%;
    margin: 0;
    align-self: start;

    display: grid;
    gap: 1rem;
  }

  /*** tekt box**/

  .section-text > * {
    margin: 0;
  }

  .section-text > h4 {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .section-text > h2 {
    max-width: 20ch;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
  }

  .section-text > p {
    max-width: 42ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-neutrals-900);
  }

  /************ kontak info liste********/

  /* KONTAKTLISTE */

  .info > ul {
    display: grid;
    gap: 2.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .info li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .info li > span {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
  }

  .info li > span > :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .info li > div > p {
    margin: 0 0 0.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted, #626879);
  }

  .info a,
  .info strong {
    font-size: 1rem;
    font-weight: 600;
    color: inherit;
    text-decoration: none;
  }

  /* BILLEDCOLLAGE */

  section > .Process-pic {
    width: 55%;
    justify-self: end;
    align-self: start;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1rem;

    /* Proportionen på hele collagens ramme. */
    aspect-ratio: 1.3;
  }

  .Process-pic > figure {
    position: relative;
    min-width: 0;
    min-height: 0;
    margin: 0;
  }

  .Process-pic > figure:first-child {
    grid-column: 1;
    grid-row: 1 / 3;
    isolation: isolate;
  }

  /* Grøn dekoration bag det høje billede. */
  .Process-pic > figure:first-child::before {
    content: "";
    position: absolute;
    left: -1.5rem;
    bottom: -1.5rem;
    width: 95%;
    height: 30%;
    border-radius: 1rem;
    background: var(--color-green-400, #a3eba3);
    z-index: -1;
  }

  .Process-pic > figure > :global(img) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 1rem;
  }

  @media (max-width: 48rem) {
    section > article,
    section > .Process-pic {
      width: 100%;
    }

    section > .Process-pic {
      grid-row: 2;
    }
  }

  .info > ul {
    display: grid;
    gap: 2.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .info li {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
  }

  .info li:nth-child(1) > span {
    background: #ffecbb;
    color: var(--color-action);
  }

  .info li:nth-child(2) > span {
    background: var(--color-green-400);
    color: #4eaf4e;
  }

  .info li:nth-child(3) > span {
    background: #eaeaea;
    color: var(--color-neutrals-900);
  }

  /***** billder *****/
  section > article,
  section > .Process-pic {
    grid-column: content;
    grid-row: 1;
    min-width: 0;
  }

  @media (max-width: 48rem) {
    section > .section-text,
    section > .Process-pic {
      width: 100%;
    }

    section > .Process-pic {
      grid-row: 2;
    }
  }
