// import api from //ftk-api.pages.dev//experience
---

<!-- gul donot chart -->
<section class="experience-content">
  <div class="section-text">
    <!-- <h4>{experience.eyebrow}</h4>
    <h2>{experience.title}</h2>
    <p>{experience.subtitle}</p> -->

    <h4>Experience</h4>
    <h2>More than 25 years of experience</h2>
    <p>3000+ our clients are insured around the World</p>
  </div>

  <article class="donut_section">
  <figure data-value="85">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="track"></circle>
      <circle class="progress" pathLength="100"></circle>
      <circle class="marker"></circle>
    </svg>
    <figcaption>Consistency</figcaption>
  </figure>

  <figure data-value="95">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="track"></circle>
      <circle class="progress" pathLength="100"></circle>
      <circle class="marker"></circle>
    </svg>
    <figcaption>Improvement</figcaption>
  </figure>

  <figure data-value="90">
    <svg viewBox="0 0 100 100" aria-hidden="true">
      <circle class="track"></circle>
      <circle class="progress" pathLength="100"></circle>
      <circle class="marker"></circle>
    </svg>
    <figcaption>Branching</figcaption>
  </figure>
</article>
</section>






<style>
  section {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, calc(var(--content-width, 75rem) / 3))
      [middle] minmax(0, calc(var(--content-width, 75rem) * 2 / 3))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];

    align-items: center;
    row-gap: 2.5rem;
    padding-block: var(--section-space, 5rem);

    background-color: var(--color-yellow-500, #ffcc41);
    color: #080d18;
  }

  section > .section-text {
    grid-column: content-start / middle;
    min-width: 0;
    padding-inline-end: 2rem;

    display: grid;

    gap: 1rem;
  }

  .section-text > * {
    margin: 0;
  }

  .section-text > h4 {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    justify-self: left;
  }

  .section-text > h2 {
    max-width: 20ch;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
  }

  .section-text > p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-neutrals-900);
  }


/************** donut graf ************/
section .donut_section{
grid-column: middle / content-end;
min-width: 0;
display: grid;
grid-template-columns: repeat(3, minmax(0, 1fr));
gap: clamp(1rem, 3vw, 3rem);

}


.donut_section > {
  --value: attr(data-value type(<number>));
  --value-string: attr(data-value);
  --value-procent: calc(var(--value) * 1%);

  container-type: inline-size;
  display: grid;
  grid-template-rows: auto auto;
  justify-items: center;
  align-items: center;
  row-gap: 1rem;

  width: min(100%, 11rem);
  min-width: 0;
  margin: 0;
  justify-self: center;

}

figure > svg {
  grid-area: 1/1;
  display: block;
  width: 100%;
  height: auto;
  rotate: -90deg;
  overflow: visible;
}

.donut_section > figure::after {
  grid-area: 1/1;
  content: var(--value-string) "%";
  font-size: 25cqw;
  font-weight: 700;
  line-height: 1;
}

figure > figcaption {
  grid-area: 2 / 1;
  text-align: center;
  font-size: 1rem;
  font-weight: 600;
}

/* Hele ringen — svagt synlig i mellemrummet. */
.track,
.progress {
  cx: 50px;
  cy: 50px;
  r: 46px;

  fill: none;
  stroke-width: 3px;
}

.track {
  stroke: rgb(0 0 0 / 12%);
}

/* Den hvide bue viser procenten. */
.progress {
  stroke: white;
  stroke-dasharray: 100;
  stroke-dashoffset: calc(100 - var(--value));
  stroke-linecap: round;
}

/* Prikken følger procenten rundt på ringen. */
.marker {
  r: 3.5px;
  fill: #080d18;
  stroke: white;
  stroke-width: 1.5px;

  offset-path: circle(46px at 50px 50px);
  offset-distance: var(--value-procent);
}

@media (max-width: 48rem) {
  section > .section-text,
  section > .donut_section {
    grid-column: content-start / content-end;
  }

  section > .section-text {
    padding-inline-end: 0;
  }
}

