---
type Experience = {
  title: string;
  subtitle: string;
  eyebrow: string;
  stats: {
    label: string;
    value: number;
  }[];
};

const experience: Experience = await fetch(
  "https://ftk-api.pages.dev/experience",
).then((res) => res.json());
---

<section class="experience-content">
  <div class="section-text">
    <h4>{experience.eyebrow}</h4>
    <h2>{experience.title}</h2>
    <p>{experience.subtitle}</p>
  </div>

  <article class="donut_section scroll-trigger">
    {
      experience.stats.map((stat) => (
        <figure data-value={stat.value}>
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle class="track" />
            <circle class="progress" pathLength="100" />
            <circle class="marker" />
          </svg>

          <figcaption>{stat.label}</figcaption>
        </figure>
      ))
    }
  </article>
</section>

<style>
  section {
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, calc(var(--content-width, 75rem) / 3))
      [middle] minmax(0, calc(var(--content-width, 75rem) * 2 / 3))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];
    align-items: center;
    row-gap: 2.5rem;
    padding-block: var(--section-space, 5rem);
    background-color: var(--color-yellow-500, #ffcc41);
    color: #080d18;
    view-timeline-name: --experience-scroll;
    view-timeline-axis: block;
    container-name: experience;
    container-type: inline-size;
  }
  /******************** section-text  */
  section > .section-text {
    grid-column: content-start / middle;
    min-width: 0;
    padding-inline-end: 2rem;

    display: grid;

    gap: 1rem;
  }

  .section-text > * {
    margin: 0;
  }

  .section-text > h4 {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    justify-self: left;
    color: var(--color-neutrals-900);
  }

  .section-text > h2 {
    max-width: 20ch;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    line-height: 1.2;
  }

  .section-text > p {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-neutrals-900);
  }

  /************** donut graf ************/
  section .donut_section {
    grid-column: middle / content-end;
    min-width: 0;

    display: grid;
    grid-template-columns: repeat(3, 11rem);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
    justify-content: center;
  }

  @container experience (max-width: 700px) {
    section > .section-text {
      grid-column: content-start / content-end;
      padding-inline-end: 0;
    }

    section .donut_section {
      grid-column: content-start / content-end;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }
  .donut_section > figure {
    --value: attr(data-value type(<number>));
    --value-string: attr(data-value);
    container: circle / inline-size;
    display: grid;
    grid-template-rows: auto auto;
    place-items: center;
    row-gap: 1rem;
    width: min(100%, 11rem);
    min-width: 0;
    margin: 0;
    justify-self: center;
  }

  figure > svg {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    height: auto;
    rotate: -90deg;
    overflow: visible;
  }

  .donut_section > figure::after {
    grid-area: 1 / 1;
    content: var(--value-string) "%";
    font-size: 25cqw;
    font-weight: 700;
    line-height: 1;
  }

  figure > figcaption {
    grid-area: 2 / 1;
    text-align: center;
    font-size: 1rem;
    font-weight: 600;
  }

  .track,
  .progress {
    --stroke-width: 4px;
    cx: 50px;
    cy: 50px;
    r: calc(50px - var(--stroke-width) / 2);
    fill: none;
    stroke-width: var(--stroke-width);
  }

  @property --scroll-progress {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  .donut_section > figure {
    --value: attr(data-value type(<number>));
    --value-string: attr(data-value);
    --scroll-progress: 0;

    animation: donut-progress linear both;
    animation-timeline: --experience-scroll;
    animation-range: entry 0% cover 40%;
  }

  .track {
    stroke: rgb(0 0 0 / 12%);
  }

  .progress {
    stroke: var(--color-neutrals-50);
    stroke-dasharray: 100;
    stroke-dashoffset: calc(100 - (var(--value) * var(--scroll-progress)));
    stroke-linecap: round;
  }

  .marker {
    r: 3.5px;
    fill: #080d18;
    stroke: white;
    stroke-width: 1.5px;

    offset-path: circle(48px at 50px 50px);

    offset-distance: calc(var(--value) * var(--scroll-progress) * 1%);
  }

  @keyframes donut-progress {
    from {
      --scroll-progress: 0;
    }

    to {
      --scroll-progress: 1;
    }
  }

  @container (width < 500px) {
    article {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    article > div {
      grid-template-rows: auto;
      grid-row: auto;
    }
  }
</style>
