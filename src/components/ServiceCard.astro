---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
</article>

<style>
@layer components {
  article {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    min-height: 175px;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--color-blue-700-transparent);
    color: var(--color-on-surface-elevated); */
    border-radius: 20px;
  }

  h2 {
    font-size: clamp(1.25rem, 1rem + 0.5vw, 1.5rem);
    line-height: 1.2;
  }

  p {
    font-size: clamp(0.9rem, 0.85rem + 0.2vw, 1rem);
    line-height: 1.5;
  }
 a {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      margin-top: auto;
      gap: 1ch;
      color: var(--color-yellow-500, yellow);
      font-weight: bold;
    }
 article > a {
  display: flex;
  align-items: center;
  gap: 0.5rem;

  color: var(--color-yellow-500);
  font-weight: bold;
}

    svg {
      inline-size: 16px;
    }
    article > a svg {
  color: currentColor;
}
  }

  
article > p:nth-of-type(3) {
  font-weight: bold;
  color: var(--color-yellow-500);
}

