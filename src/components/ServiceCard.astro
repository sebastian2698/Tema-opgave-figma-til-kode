---
const { service } = Astro.props;
import ArrowRight from "@icons/arrow--right.svg";
---

<article>
  <h2>{service.title}</h2>
  <p>{service.description}</p>
  <a href="#0">{service.buttonText} <ArrowRight stroke-width={2.5} /></a>
  <!-- <a> burde måske være en variant af en component -->
</article>

<style>
  @layer components {
    article {
      display: flex;
      flex-direction: column;
      background: var(--color-blue-700-transparent);
      color: var(--color-on-surface-elevated);
      padding: 2rem; /* Dette burde være en token */
      border-radius: 20px; /* Dette burde være en token */
      min-height: 175px;
      padding: 2rem;
    }
    h2 {
      margin: 0 0 0.5rem;
    }
    p {
      margin: 0 0 1.25rem;
      line-height: 1.5;
    }

    a {
      display: inline-flex;
      align-items: center;
      align-self: flex-start;
      margin-top: auto;
      gap: 1ch;
      color: var(--color-action);
      font-weight: bold;
    }

    article > a {
      display: inline-flex;
      margin-top: auto;
      align-items: center;
      align-self: flex-start;
      padding-top: 2rem;
      gap: 20px;
      color: var(--color-action);
      font-weight: bold;

      svg {
        inline-size: 16px;
      }
    }
  }
</style>
