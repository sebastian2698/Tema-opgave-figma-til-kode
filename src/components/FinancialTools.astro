---
import ArrowRight from "@icons/arrow--right.svg";
import ArrowLeft from "@icons/arrow-left.svg";
import Bars from "@icons/bars.svg";
import Cal from "@icons/cal.svg";
import Card from "@icons/card.svg";
import Clock from "@icons/clock.svg";
import Gear from "@icons/gear.svg";
import Globe from "@icons/globe.svg";
import Law from "@icons/law.svg";
import Layers from "@icons/layers.svg";
import Money from "@icons/money.svg";
import Phone from "@icons/phone.svg";
import Pin from "@icons/pin.svg";

const icons = {
  bars: Bars,
  cal: Cal,
  card: Card,
  clock: Clock,
  gear: Gear,
  globe: Globe,
  law: Law,
  layers: Layers,
  money: Money,
  phone: Phone,
  pin: Pin,
};

type CardData = {
  icon: keyof typeof icons;
  title: string;
  description: string;
  link: {
    text: string;
    url: string;
  };
};

type Projections = {
  title: string;
  subtitle: string;
  eyebrow: string;
  values: CardData[];
};

const projections: Projections = await fetch(
  "https://ftk-api.pages.dev/financial-projections",
).then((res) => res.json());
---

<section>
  <div class="section-text">
    <h4>{projections.eyebrow}</h4>
    <h2>{projections.title}</h2>
    <p>{projections.subtitle}</p>
  </div>

  <article class="scroll-container">
    <div class="progressenhancement">
      <button>Hej</button>
      <button>Dig</button>
    </div>

    <ul role="list" id="scroller">
      {
        projections.values.map((card) => {
          const Icon = icons[card.icon];

          return (
            <li class="cards">
              <figure>
                <Icon />
              </figure>

              <h3>{card.title}</h3>

              <p>{card.description}</p>
            </li>
          );
        })
      }
    </ul>
  </article>
</section>

<style>
  :root {
    --content-width: 75rem;
    --padding: max(1rem, calc((100% - var(--content-width)) / 2));
  }

  section {
    background: var(--color-on-ui-primary);
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--page-padding, 1rem), 1fr)
      [content-start] minmax(0, var(--content-width, 75rem))
      [content-end] minmax(var(--page-padding, 1rem), 1fr)
      [full-end];
    min-width: 0;
    max-width: 100%;
    padding-block: 5rem;
    padding-block: var(--section-space, 5rem);

    .full {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: inherit;
      row-gap: 3rem;
    }

    > * {
      grid-column: content;
    }
  }

  section > article {
    grid-column: content;
    min-width: 0;
    margin: 0;
  }
  /************************ section-text - intro tekst ****************/
  .section-text {
    display: grid;
    gap: 0.75rem;
    inline-size: min(100%, 600px);
    justify-self: start;
    margin-block-end: 2rem;
  }

  .section-text > * {
    margin: 0;
  }

  .section-text p {
    max-width: 560px;
    line-height: 1.6;
  }

  h2 {
    max-width: 14ch;
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.1;
    color: var(--color-neutrals-900);
  }
  p {
    max-width: 45ch;
    margin: 0 0 1.5rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  h4 {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    justify-self: left;
  }

  /******************* scroll-container ***********/
  .scroll-container {
    grid-column: content-start / full-end;
    min-width: 0;
    position: relative;
  }

  .scroll-container > ul {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-inline: max(1rem, calc((100% - var(--content-width)) / 2));
    scroll-padding-inline: max(1rem, calc((100% - var(--content-width)) / 2));
    padding-block: 1rem;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
    align-items: stretch;
  }

  .scroll-container > ul::-webkit-scrollbar {
    display: none;
  }

  #scroller {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-inline: 0 1rem;
    scroll-padding-inline: 0 1rem;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
  }

  /*************** arrow - button *************/

  .progressenhancement button {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-inline: 0 1rem;
    scroll-padding-inline: 0 1rem;
    scrollbar-width: none;
    list-style: none;
    margin: 0;
  }

  @supports selector(ul::-webkit-scrollbar) {
    .progressenhancement {
      display: none;
    }

    #scroller::scroll-button(left),
    #scroller::scroll-button(right) {
      width: 50px;
      aspect-ratio: 1;
      border: 0;
      border-radius: 50%;
      background: var(--color-neutrals-900);
      color: white;
      font-size: 1.5rem;
      cursor: pointer;
      position: absolute;
      top: -4.5rem;
    }

    #scroller::scroll-button(right) {
      content: "→" / "Næste kort";
      right: max(1rem, calc((100vw - var(--content-width)) / 2));
    }

    #scroller::scroll-button(left) {
      content: "←" / "Forrige kort";
      right: calc(max(1rem, calc((100vw - var(--content-width)) / 2)) + 66px);
    }
  }
  /************* cards ********************/

  .cards {
    flex: 0 0 min(379px, 85vw);
    scroll-snap-align: start;
    background-color: var(--color-surface-tertiary);
    border-radius: 20px;
    padding: 45px 20px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
</style>
